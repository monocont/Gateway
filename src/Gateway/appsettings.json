{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning",
            "Ocelot": "Information"
        }
    },
    "AllowedHosts": "*",
    "JwtSettings": {
        "Issuer": "Service.Seguridad",
        "Audience": "Monocont",
        "JwksUri": "http://localhost:5000/.well-known/jwks"
    },
    "GatewaySettings": {
        "SecretKey": "CAMBIA_ESTA_CLAVE_SECRETA_POR_UNA_SEGURA_EN_PRODUCCION",
        "AllowedTimestampDiffSeconds": 300,
        "SkipSignatureForPaths": [
            "/health",
            "/.well-known",
            "/seguridad_service",
            "/empresa_service",
            "/catalogos_service",
            "/operaciones_service",
            "/api/v1"
        ]
    }
}